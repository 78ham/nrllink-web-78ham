# 复制为 .env 后按需修改（docker compose 会自动读取同目录的 .env）。

# ---- 镜像 ----
NRL_IMAGE=ghcr.io/78ham/nrllink:latest
NRL_WEB_IMAGE=ghcr.io/78ham/nrllink-web:latest

# ---- 前端：对公网开放 ----
WEB_BIND=0.0.0.0
WEB_PORT=80

# ---- 后端接口：对局域网开放 ----
# 默认 0.0.0.0 = 所有网卡，局域网可访问。
# ★ 必须确保防火墙 / 安全组没有把 9000 暴露到公网，否则接口会被公网直接访问。
# 更严格的做法：改成服务器的局域网网卡地址（如 192.168.1.10），只监听内网。
# 前端容器不依赖这个端口（它走 Docker 网络直连后端），所以只绑 127.0.0.1 也能正常工作。
API_BIND=0.0.0.0
API_PORT=9000

# ---- 设备接入：必须对公网开放，不能走 HTTP 反向代理 ----
UDP_PORT=60050

# ---- 其他 ----
# JWT 签名密钥：留空则沿用后端镜像内置配置里的值。
# 生产建议设置（首次执行 ./install.sh 会自动生成），否则重启后需重新登录。
TOKEN_KEY=